<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up: the session, caches and drafts are per device. A restored phone signs in
     again. -->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
